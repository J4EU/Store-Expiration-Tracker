# SSH와 Nginx 접근을 허용할 운영자 네트워크의 공인 IPv4 주소를 입력한다.
# 집/편의점에서 각각 현재 사용 중인 공인 IPv4를 확인한 뒤 예시 주소를 교체한다.
# /32는 단일 IPv4 주소만 허용한다는 의미다.
# 공인 IP가 변경되면 이 값도 함께 갱신해야 한다.
allowed_operator_cidrs = [
  "203.0.113.10/32", # 집
  "203.0.113.11/32", # 편의점
]

# infra/data-ebs 레이어를 apply한 뒤 출력된 볼륨 ID를 입력한다.
data_volume_id = "vol-0123456789abcdef0"
